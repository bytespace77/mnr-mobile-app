<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.safeg.facedetection.GraphicOverlay
        android:id="@+id/graphic_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <TextView
        android:id="@+id/tvDetectionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="80dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:elevation="10dp"
        android:text="Loading..."
        app:layout_constraintBottom_toTopOf="@id/add_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/previewView" />

    <androidx.cardview.widget.CardView
        android:id="@+id/preview_img_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/add_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDetectionText">

        <ImageView
            android:id="@+id/preview_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/roundedcorner"
            android:contentDescription="Preview Photo"
            android:scaleType="centerInside"
            android:src="@drawable/outline_image_24"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/add_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetectionText" />
    </androidx.cardview.widget.CardView>

    <ImageButton
        android:id="@+id/add_btn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/white_roundedcorner"
        android:contentDescription="register face"
        android:src="@drawable/outline_add_black_48"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/switch_camera"
        app:layout_constraintStart_toEndOf="@id/preview_img_card"
        app:layout_constraintTop_toBottomOf="@id/tvDetectionText"
        android:layout_marginBottom="50dp"
        android:elevation="10dp"
        app:tint="@color/teal_700" />

    <ImageButton
        android:id="@+id/clear_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/white_roundedcorner"
        android:contentDescription="register face"
        android:src="@drawable/ic_search"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/switch_camera"
        app:layout_constraintStart_toEndOf="@id/preview_img_card"
        app:layout_constraintTop_toBottomOf="@id/tvDetectionText"
        android:layout_marginBottom="50dp"
        android:elevation="10dp"
        app:tint="@color/teal_700" />

    <ImageButton
        android:id="@+id/switch_camera"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background= "@drawable/roundedcorner"
        android:contentDescription="switch camera"
        android:src="@drawable/outline_flip_camera_android_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/add_btn"
        app:layout_constraintTop_toBottomOf="@id/tvDetectionText" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="50dp"
        android:src="@drawable/back_btn" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:weightSum="4.5">

        <LinearLayout
            android:id="@+id/llTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:background="@color/purple_700"
            android:gravity="center"
            android:orientation="vertical">



            <View
                android:id="@+id/vTop"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/black" />

            <TextView
                android:id="@+id/tvPlaceYourMyKad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Facial Recognition Process in"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <LinearLayout
                android:id="@+id/llPositionMyKadScanMyKad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Progress."
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14ssp"
                    android:fontFamily="@font/montserrat_regular"/>

            </LinearLayout>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/centerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="10"
                    android:background="@color/purple_700" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="80"
                    android:background="@drawable/activity_scan_mykad_scan_area">

                    <ImageView
                        android:id="@+id/ivDots1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>
                    <ImageView
                        android:id="@+id/ivDots7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                    <ImageView
                        android:id="@+id/ivDots8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>
                    <ImageView
                        android:id="@+id/ivDots9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:visibility="gone"
                        android:src="@drawable/face_detection_dots"/>

                </RelativeLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="10"
                    android:background="@color/purple_700" />

            </LinearLayout>



        </RelativeLayout>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingTop="@dimen/_30sdp"
            android:background="@color/purple_700"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/text_size_sm"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/_15sdp"/>

            <ProgressBar
                android:id="@+id/customProgress"
                style="@style/CustomProgressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_7sdp"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:progress="0"
                android:max="100"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>