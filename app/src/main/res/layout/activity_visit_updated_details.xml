<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wo_logo"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_20sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:weightSum="4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:elevation="50dp"
            android:src="@drawable/back_btn" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Please Update Visit Details"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_md"
            android:textStyle="bold"
            android:padding="@dimen/_6sdp"
            android:fontFamily="@font/montserrat_bold"
            android:background="@drawable/bg_glassy_translucent"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#40ffffff"
        app:cardPreventCornerOverlap="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassy_translucent"
            android:orientation="vertical"
            android:padding="@dimen/padding_lg">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/bg_glassy_translucent">


        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:src="@drawable/ic_search"
            app:tint="@color/white"/>

        <View
            android:id="@+id/view1"
            android:layout_width="@dimen/_2sdp"
            android:layout_height="@dimen/_2sdp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_toStartOf="@id/ivSearch"
            android:background="#C8CCDD" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/view1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">


            <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
                android:id="@+id/spCompany"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@color/white"
                app:smsp_enableFloatingLabel="false"
                app:smsp_floatingLabelText=""
                app:smsp_hint="Search company"
                app:smsp_hintSize="@dimen/text_size_md"
                app:smsp_isSearchable="true"
                app:smsp_itemColor="#22306d"
                app:smsp_itemListColor="#7C4DFF"
                app:smsp_itemSize="@dimen/text_size_md"
                app:smsp_multilineError="false"
                android:pointerIcon="none"
                app:smsp_searchHeaderText="Select Company"
                app:smsp_selectedItemListColor="#22306d"
                android:visibility="gone"
                app:smsp_underlineColor="@color/white" />

        </LinearLayout>
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_toStartOf="@id/view1"
            android:background="@android:color/transparent"
            android:hint="Search Host"
            android:textColor="@color/white"
            android:textColorHint="#C8CCDD"
            android:singleLine="true"
            android:maxLines="1"
            android:textSize="@dimen/text_size_md" />

    </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStaffList"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/_20sdp"/>

               </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="200dp"
        android:layout_weight="3.5">

        <LinearLayout
            android:id="@+id/llVisitDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="#40ffffff"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glassy_translucent"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_lg">

                    <!--Reason-->
                    <!--Reason-->
                    <LinearLayout
                        android:id="@+id/llReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:padding="@dimen/_4sdp"
                        android:background="@drawable/bg_glassy_translucent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reason"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_8ssp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:src="@drawable/activity_card_details_my_kad_ic_email"
                                app:tint="@color/white" />

                            <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
                                android:id="@+id/spReason"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:background="@android:color/transparent"
                                app:smsp_enableFloatingLabel="false"
                                app:smsp_floatingLabelText=""
                                app:smsp_hint=""
                                app:smsp_isSearchable="true"
                                app:smsp_itemColor="@color/white"
                                app:smsp_itemListColor="@color/colorPrimary"
                                app:smsp_itemSize="@dimen/text_size_xsm"
                                app:smsp_multilineError="false"
                                app:smsp_arrowColor="@color/white"
                                app:smsp_searchHeaderText="Select Reason"
                                app:smsp_selectedItemListColor="@color/purple_700"
                                app:smsp_underlineColor="@android:color/transparent" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/viewReason"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="#00F4F4F4" />

                    <!--Location-->
                    <LinearLayout
                        android:id="@+id/llLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:padding="@dimen/_4sdp"
                        android:background="@drawable/bg_glassy_translucent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visitor Type"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_8ssp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:src="@drawable/activity_card_details_my_kad_ic_address"
                                app:tint="@color/white" />

                            <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
                                android:id="@+id/spLocation"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:background="@android:color/transparent"
                                app:smsp_enableFloatingLabel="false"
                                app:smsp_floatingLabelText=""
                                app:smsp_hint=""
                                app:smsp_isSearchable="true"
                                app:smsp_itemColor="@color/white"
                                app:smsp_itemListColor="@color/colorPrimary"
                                app:smsp_itemSize="@dimen/text_size_xsm"
                                app:smsp_multilineError="false"
                                app:smsp_searchHeaderText="Select Visitor Type"
                                app:smsp_selectedItemListColor="@color/purple_700"
                                app:smsp_arrowColor="@color/white"
                                app:smsp_underlineColor="@android:color/transparent" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/viewLocation"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="#00F4F4F4" />


                    <!--Sub Location-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sub Location"
                            android:textColor="#C8CCDD"
                            android:textSize="@dimen/text_size_sm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:src="@drawable/activity_card_details_my_kad_ic_address" />

                            <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
                                android:id="@+id/spSubLocation"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:background="@color/white"
                                app:smsp_enableFloatingLabel="false"
                                app:smsp_floatingLabelText=""
                                app:smsp_hint=""
                                app:smsp_isSearchable="true"
                                app:smsp_itemColor="#22306d"
                                app:smsp_itemListColor="#7C4DFF"
                                app:smsp_itemSize="@dimen/text_size_md"
                                app:smsp_multilineError="false"
                                app:smsp_searchHeaderText="Select Sub Location"
                                app:smsp_selectedItemListColor="#22306d"
                                app:smsp_underlineColor="@color/white" />

                        </LinearLayout>


                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="#00F4F4F4" />

                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <RelativeLayout
                android:id="@+id/rlNext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_40sdp"
                android:background="@drawable/rounded_bg_white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:text="Next"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_md"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:src="@drawable/activity_card_details_my_kad_ic_next_btn_right_icon"
                    app:tint="@color/colorPrimary"/>

            </RelativeLayout>

        </LinearLayout>
    </ScrollView>
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:layout_weight="0.5">
    <RelativeLayout
        android:id="@+id/rlMainPage"
        android:layout_width="@dimen/_230sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center"
        android:background="@drawable/rounded_bg_white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Back to Previous Screen"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_md"
            android:gravity="center"
            android:textAlignment="center"
            android:textStyle="bold" />

    </RelativeLayout>
</RelativeLayout>
</LinearLayout>